@{
    ViewData["Title"] = "Reset Password | CodeSync";
}

@section SEO {
    <meta name="robots" content="noindex, nofollow" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            @if (TempData["foundError"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@TempData["foundError"]</span>
                </div>
            }
            @if (TempData["timeOut"] != null)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-hourglass-bottom"></i>
                    <span>@TempData["timeOut"]</span>
                </div>
            }
            @if (TempData["errOtp"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-shield-x"></i>
                    <span>@TempData["errOtp"]</span>
                </div>
            }

            <div class="card p-4 p-md-5 border-0 shadow-lg">
                <div class="text-center mb-4">
                    <div class="brand-badge mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Recover Password</h3>
                    <p class="text-muted small">Enter your registered email to receive a verification OTP code</p>
                </div>

                <form method="post">
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Registered Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="email" class="form-control border-start-0 ps-0" placeholder="your.name@example.com" required autofocus />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-send-fill me-1"></i> Send Verification Code
                    </button>
                </form>

                <hr class="my-4 border-secondary-subtle">

                <div class="text-center">
                    <a asp-action="Login" asp-controller="Authentication" class="text-primary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

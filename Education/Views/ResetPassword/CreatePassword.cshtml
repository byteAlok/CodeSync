@inject IHttpContextAccessor HttpContextAccessor
@{
    var email = HttpContextAccessor.HttpContext.Session.GetString("email") ?? "";
    ViewData["Title"] = "Create New Password | CodeSync";
}

@section SEO {
    <meta name="robots" content="noindex, nofollow" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            @if (TempData["verifyOtp"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["verifyOtp"]</span>
                </div>
            }
            @if (TempData["mismatch"] != null)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["mismatch"]</span>
                </div>
            }

            <div class="card p-4 p-md-5 border-0 shadow-lg">
                <div class="text-center mb-4">
                    <div class="brand-badge mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
                        <i class="bi bi-lock-fill"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Set New Password</h3>
                    <p class="text-muted small">Choose a secure password for your CodeSync account</p>
                </div>

                <form method="post">
                    <!-- Email Display (Readonly) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Email</label>
                        <input type="text" readonly value="@email" name="Email" class="form-control bg-body-tertiary" />
                    </div>

                    <!-- New Password -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0 text-muted"><i class="bi bi-key"></i></span>
                            <input type="password" name="pass" class="form-control border-start-0 ps-0" placeholder="Min. 8 characters" required minlength="8" maxlength="16" autofocus />
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0 text-muted"><i class="bi bi-check2-circle"></i></span>
                            <input type="password" name="cpass" class="form-control border-start-0 ps-0" placeholder="Repeat password" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-shield-check me-1"></i> Update Password & Sign In
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

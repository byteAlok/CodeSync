@inject IHttpContextAccessor HttpContextAccessor
@{
    var email = HttpContextAccessor.HttpContext.Session.GetString("email") ?? "";
    ViewData["Title"] = "Verify OTP | CodeSync";
}

@section SEO {
    <meta name="robots" content="noindex, nofollow" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            @if (TempData["sentOtp"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["sentOtp"]</span>
                </div>
            }
            @if (TempData["errorOtp"] != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@TempData["errorOtp"]</span>
                </div>
            }

            <div class="card p-4 p-md-5 border-0 shadow-lg">
                <div class="text-center mb-4">
                    <div class="brand-badge mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Verify OTP</h3>
                    <p class="text-muted small">Enter the numeric code sent to your email</p>
                </div>

                <form method="post">
                    <!-- Email Display (Readonly) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email Address</label>
                        <input type="text" readonly value="@email" name="email" class="form-control bg-body-tertiary" />
                    </div>

                    <!-- OTP Code Input -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small">6-Digit Verification Code</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                            <input type="number" name="userOtp" class="form-control border-start-0 ps-0" placeholder="Enter OTP" required autofocus />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-check2-circle me-1"></i> Verify & Proceed
                    </button>
                </form>

                <hr class="my-4 border-secondary-subtle">

                <div class="text-center">
                    <a asp-action="ForgetPassword" asp-controller="ResetPassword" class="text-primary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i> Request a New Code
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

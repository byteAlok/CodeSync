<!-- ===== CONTACT SECTION ===== -->
<section class="py-5 bg-body-tertiary" id="contact">
    <div class="container-xl">
        <div class="text-center max-w-700 mx-auto mb-5">
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                GET IN TOUCH
            </div>
            <h2 class="display-6 fw-bold">Have Questions? Reach Out to CodeSync</h2>
            <p class="text-muted">Our engineering and admissions team is here to assist you with curriculum advice or technical support.</p>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Contact Form -->
            <div class="col-12 col-lg-7">
                <div class="card p-4 p-md-5 border-0 shadow-sm">
                    <h4 class="fw-bold mb-4">Send Us a Direct Message</h4>

                    @if (TempData["Msg"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>@TempData["Msg"]</span>
                        </div>
                    }

                    <form method="post" asp-action="Contact" asp-controller="Contact" asp-antiforgery="true">
                        <div class="mb-3">
                            <label for="email" class="form-label fw-semibold">Your Email Address</label>
                            <input type="email" class="form-control" name="ContactEmail" id="email" placeholder="engineer@example.com" required />
                        </div>
                        <div class="mb-4">
                            <label for="message" class="form-label fw-semibold">Your Message or Inquiry</label>
                            <textarea class="form-control" name="ContactMessage" id="message" rows="4" placeholder="Tell us what you'd like to learn or how we can assist you..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-send-fill me-2"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>

            <!-- Contact Cards Sidebar -->
            <div class="col-12 col-lg-5">
                <div class="d-flex flex-column gap-3">
                    <div class="card p-3 border-0 shadow-sm hover-lift d-flex flex-row align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                            <i class="bi bi-geo-alt-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Campus Location</h6>
                            <p class="text-muted small mb-0">Brahmasthan, Azamgarh (UP), India</p>
                        </div>
                    </div>

                    <div class="card p-3 border-0 shadow-sm hover-lift d-flex flex-row align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-success-subtle text-success">
                            <i class="bi bi-telephone-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Phone Support</h6>
                            <p class="text-muted small mb-0">+91 97087 98088</p>
                        </div>
                    </div>

                    <div class="card p-3 border-0 shadow-sm hover-lift d-flex flex-row align-items-center gap-3">
                        <div class="p-3 rounded-circle bg-info-subtle text-info">
                            <i class="bi bi-envelope-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Email Inquiries</h6>
                            <p class="text-muted small mb-0">contact@codesync.com</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

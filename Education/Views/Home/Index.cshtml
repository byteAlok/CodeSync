@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "CodeSync | Modern E-Learning Platform for Software Engineers";
    var Uid = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");
}

@section SEO {
    <meta name="description" content="CodeSync is a premier developer-focused e-learning platform created by Full Stack Engineer Alok Maurya. Master Full Stack Web Development, C#, ASP.NET Core, JavaScript, React, Backend Architecture, and Data Analytics through hands-on projects." />
    <meta name="keywords" content="CodeSync, Alok Maurya, Full Stack Developer, ASP.NET Core MVC, C#, React.js, Next.js, Node.js, Web Development, Programming Courses, Software Engineering" />
    <link rel="canonical" href="@SiteData.SiteUrl/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@SiteData.SiteUrl/" />
    <meta property="og:title" content="CodeSync | Modern E-Learning for Developers" />
    <meta property="og:description" content="Empowering developers to build industry-ready applications with hands-on projects and guided engineering tracks. Built by Alok Maurya." />
    <meta property="og:image" content="@SiteData.SiteUrl/images/home-images/codesync_hero.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="@SiteData.SiteUrl/" />
    <meta property="twitter:title" content="CodeSync | Modern E-Learning for Developers" />
    <meta property="twitter:description" content="Empowering developers to build industry-ready applications with hands-on projects and guided engineering tracks." />
    <meta property="twitter:image" content="@SiteData.SiteUrl/images/home-images/codesync_hero.jpg" />

    <!-- Schema.org Structured Data (WebSite & Person for Alok Maurya) -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "CodeSync",
      "url": "@SiteData.SiteUrl/",
      "description": "Premium developer education platform specializing in full-stack web development and software engineering.",
      "creator": {
        "@@type": "Person",
        "name": "Alok Maurya",
        "jobTitle": "Full Stack Engineer",
            "url": "https://aloksde.vercel.app/",
        "sameAs": [
          "https://linkedin.com",
          "https://github.com"
        ],
        "knowsAbout": ["C#", "ASP.NET Core", "JavaScript", "React.js", "Next.js", "Node.js", "SQL Server", "Full Stack Development"]
      }
    }
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/home.css" asp-append-version="true" />
}

<!-- ===== HERO SECTION ===== -->
<section class="hero-section py-5 py-lg-6 position-relative overflow-hidden">
    <div class="container-xl position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <!-- Text Column -->
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 bg-primary-subtle text-primary border border-primary-subtle small fw-bold">
                    <i class="bi bi-stars"></i> Next-Gen Developer Education
                </div>
                <h1 class="display-4 fw-black lh-sm mb-3">
                    Master Modern <span class="text-gradient">Software Engineering</span> with CodeSync
                </h1>
                <p class="lead text-muted mb-4 fs-6 fs-md-5">
                    Accelerate your programming career through production-grade projects, interactive engineering roadmaps, and real-world architectures designed for ambitious developers.
                </p>
                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <a class="btn btn-primary btn-lg px-4" asp-action="Register" asp-controller="Authentication">
                        <i class="bi bi-rocket-takeoff me-2"></i> Join for Free
                    </a>
                    <a class="btn btn-outline-primary btn-lg px-4" asp-action="Services" asp-controller="Services">
                        <i class="bi bi-grid-fill me-2"></i> Explore Courses
                    </a>
                </div>
                <!-- Mini Stats / Badges -->
                <div class="row g-3 pt-3 border-top border-secondary-subtle">
                    <div class="col-4">
                        <h4 class="fw-bold mb-0 text-primary">100%</h4>
                        <small class="text-muted">Project-Based</small>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold mb-0 text-purple" style="color: var(--cs-purple-500);">24/7</h4>
                        <small class="text-muted">Mentor Support</small>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold mb-0 text-success">Verified</h4>
                        <small class="text-muted">Certifications</small>
                    </div>
                </div>
            </div>

            <!-- Hero Image Visual -->
            <div class="col-lg-6 text-center">
                <div class="position-relative d-inline-block">
                    <div class="hero-glow-bg"></div>
                    <div class="card border-0 shadow-2-strong rounded-4 overflow-hidden" style="box-shadow: 0 25px 50px -12px rgba(124, 58, 237, 0.25);">
                        <img src="~/images/home-images/codesync_hero.jpg" class="img-fluid hero-main-img" alt="Modern Developer Studio" onerror="this.src='/images/course-images/Full_Stack_Web_Development__202512012038141148.png'" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== FEATURED COURSES SECTION ===== -->
<section class="py-5 bg-body-tertiary" id="courses">
    <div class="container-xl">
        <div class="text-center max-w-700 mx-auto mb-5">
            <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                CURATED CURRICULUM
            </div>
            <h2 class="display-6 fw-bold mb-2">Explore Industry-Ready Courses</h2>
            <p class="text-muted">Carefully structured roadmaps crafted by engineering leaders to take you from foundational syntax to scalable software systems.</p>
        </div>

        <div class="row g-4">
            <!-- Course 1 -->
            <div class="col-12 col-md-6 col-lg-4" id="web">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="ratio ratio-16x9">
                        <img src="~/images/course-images/Full_Stack_Web_Development__202512012038141148.png" class="card-img-top object-fit-cover" alt="Full Stack Web Development" />
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge-new">POPULAR</span>
                            <span class="badge bg-body-secondary text-body">Full Stack</span>
                        </div>
                        <h5 class="card-title fw-bold text-gradient mb-2">Full Stack Web Development</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Build complete web platforms with modern frontend frameworks, ASP.NET Core APIs, relational databases, and cloud deployment pipelines.
                        </p>
                        <hr class="my-3 border-secondary-subtle">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> 6 Months</small>
                            <a asp-action="Services" asp-controller="Services" class="btn btn-outline-primary btn-sm px-3">
                                View Details <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course 2 -->
            <div class="col-12 col-md-6 col-lg-4" id="mobile">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="ratio ratio-16x9">
                        <img src="~/images/course-images/Mobile_Application_Development.png" class="card-img-top object-fit-cover" alt="Mobile App Development" />
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge-new">NEW</span>
                            <span class="badge bg-body-secondary text-body">Mobile</span>
                        </div>
                        <h5 class="card-title fw-bold text-gradient mb-2">Mobile App Engineering</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Design, architect, and deploy cross-platform iOS and Android apps with reactive UI patterns, native device APIs, and real-time backend integration.
                        </p>
                        <hr class="my-3 border-secondary-subtle">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> 4 Months</small>
                            <a asp-action="Services" asp-controller="Services" class="btn btn-outline-primary btn-sm px-3">
                                View Details <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course 3 -->
            <div class="col-12 col-md-6 col-lg-4" id="backend">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="ratio ratio-16x9">
                        <img src="~/images/course-images/backend_Development.png" class="card-img-top object-fit-cover" alt="Backend Development" />
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge-new">ADVANCED</span>
                            <span class="badge bg-body-secondary text-body">Backend & Cloud</span>
                        </div>
                        <h5 class="card-title fw-bold text-gradient mb-2">Backend Architecture & APIs</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Master distributed services, RESTful & GraphQL APIs, caching layers, database indexing, and enterprise security standards.
                        </p>
                        <hr class="my-3 border-secondary-subtle">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> 5 Months</small>
                            <a asp-action="Services" asp-controller="Services" class="btn btn-outline-primary btn-sm px-3">
                                View Details <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course 4 -->
            <div class="col-12 col-md-6 col-lg-4" id="programming">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="ratio ratio-16x9">
                        <img src="~/images/course-images/Programming-Language-Popularity.jpg" class="card-img-top object-fit-cover" alt="Programming Languages" />
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge-new">FOUNDATION</span>
                            <span class="badge bg-body-secondary text-body">Core DSA</span>
                        </div>
                        <h5 class="card-title fw-bold text-gradient mb-2">Modern Programming Languages</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Deep dive into C#, JavaScript/TypeScript, and Python syntax, memory management, object-oriented design, and algorithms.
                        </p>
                        <hr class="my-3 border-secondary-subtle">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> 3 Months</small>
                            <a asp-action="Services" asp-controller="Services" class="btn btn-outline-primary btn-sm px-3">
                                View Details <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course 5 -->
            <div class="col-12 col-md-6 col-lg-4" id="hacking">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="ratio ratio-16x9">
                        <img src="~/images/course-images/A-Complete-Guide-to-Ethical-Hacking.png" class="card-img-top object-fit-cover" alt="Ethical Hacking" />
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge-new">SECURITY</span>
                            <span class="badge bg-body-secondary text-body">Cybersecurity</span>
                        </div>
                        <h5 class="card-title fw-bold text-gradient mb-2">Ethical Hacking & Defense</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Learn penetration testing, vulnerability discovery, threat modeling, and defensive system hardening through sandboxed labs.
                        </p>
                        <hr class="my-3 border-secondary-subtle">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> 4 Months</small>
                            <a asp-action="Services" asp-controller="Services" class="btn btn-outline-primary btn-sm px-3">
                                View Details <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Course 6 -->
            <div class="col-12 col-md-6 col-lg-4" id="data">
                <div class="card h-100 border-0 shadow-sm hover-lift">
                    <div class="ratio ratio-16x9">
                        <img src="~/images/course-images/big-data-analytics-and-business-intelligence-thumbnail.jpg" class="card-img-top object-fit-cover" alt="Data Analytics" />
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge-new">ANALYTICS</span>
                            <span class="badge bg-body-secondary text-body">Data Science</span>
                        </div>
                        <h5 class="card-title fw-bold text-gradient mb-2">Data Analytics & Insights</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            Extract actionable intelligence from complex datasets using SQL, Python analytical libraries, ETL pipelines, and interactive dashboards.
                        </p>
                        <hr class="my-3 border-secondary-subtle">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> 4 Months</small>
                            <a asp-action="Services" asp-controller="Services" class="btn btn-outline-primary btn-sm px-3">
                                View Details <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a asp-action="Services" asp-controller="Services" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-mortarboard me-2"></i> Browse Complete Catalog
            </a>
        </div>
    </div>
</section>

<!-- ===== LATEST UPDATES ===== -->

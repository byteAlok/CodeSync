                            <h6 class="fw-bold mb-1">Direct Engineering Mentorship</h6>
                            <p class="text-muted small mb-0">Receive code reviews, feedback, and career guidance directly from experienced engineers.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="p-2 rounded-circle bg-primary-subtle text-primary">
                            <i class="bi bi-check2-circle fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Self-Paced Flexible Access</h6>
                            <p class="text-muted small mb-0">Study on your own schedule with lifetime access to batch content and regular updates.</p>
                        </div>
                    </div>
                </div>

                <a asp-action="AboutUs" asp-controller="Home" class="btn btn-primary px-4">
                    Learn More About Us <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>


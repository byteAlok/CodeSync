                            <i class="bi bi-rocket-takeoff-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Full Stack ASP.NET 8</h5>
                            <small class="text-muted"><i class="bi bi-calendar-event me-1"></i> Released Recently</small>
                        </div>
                    </div>
                    <p class="text-muted mb-0 small">
                        New enterprise modules covering microservices, Entity Framework Core 8 optimizations, and clean architecture patterns are now live in the course portal.
                    </p>
                </div>
            </div>

            <!-- Update 2 -->
            <div class="col-12 col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="p-2 rounded-3 bg-warning text-dark">
                            <i class="bi bi-lightning-charge-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Live Coding Sessions</h5>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i> Weekly Series</small>
                        </div>
                    </div>
                    <p class="text-muted mb-0 small">
                        Interactive weekend live coding workshops focusing on system design, frontend optimization with React, and mock technical interview rounds.
                    </p>
                </div>
            </div>

            <!-- Update 3 -->
            <div class="col-12 col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="p-2 rounded-3 bg-success text-white">
                            <i class="bi bi-trophy-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Milestone Reached</h5>
                            <small class="text-muted"><i class="bi bi-star-fill me-1"></i> Community Growth</small>
                        </div>
                    </div>
                    <p class="text-muted mb-0 small">
                        CodeSync has successfully supported learners across multiple domains in landing software engineering positions. Thank you to our vibrant community!
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== ABOUT SECTION ===== -->
<section class="py-5 bg-body-tertiary" id="about">
    <div class="container-xl">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="~/images/home-images/codesync_about.jpg" class="img-fluid rounded-4 shadow-lg" alt="About CodeSync Team Collaboration" onerror="this.src='/images/home-images/codesync_hero.jpg'" />

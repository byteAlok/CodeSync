@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg text-center p-4 p-md-5">
                <div class="mb-4">
                    <div class="badge bg-danger-subtle text-danger rounded-circle p-3 mb-2" style="font-size: 2.5rem; width: 80px; height: 80px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-2">Oops! Something Went Wrong</h2>
                <p class="text-muted mb-4">An unexpected error occurred while processing your request. Our engineering team has been notified.</p>

                @if (Model.ShowRequestId)
                {
                    <div class="p-3 bg-body-tertiary rounded-3 mb-4 text-start">
                        <small class="text-muted d-block">Request ID:</small>
                        <code class="text-primary small fw-semibold">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-1"></i> Return Home
                    </a>
                    <a asp-action="Contact" asp-controller="Contact" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-headset me-1"></i> Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    Layout = "_Layout";
}

@{
    var pageTitle = ViewData["Title"] as string;
}

@section Styles {
    <link href="~/css/Admin/sidebar.css" rel="stylesheet" asp-append-version="true" />

    @if (pageTitle == "Index")
    {
        <link href="~/css/Admin/index.css" rel="stylesheet" asp-append-version="true" />
    }
    else if (pageTitle == "Students")
    {
        <link href="~/css/Admin/student.css" rel="stylesheet" asp-append-version="true" />
    }
    else if (pageTitle == "Teacher" || pageTitle == "Product")
    {
        <link href="~/css/Admin/Teacher.css" rel="stylesheet" asp-append-version="true" />
    }
    else if (pageTitle == "Course")
    {
        <link href="~/css/Admin/course.css" rel="stylesheet" asp-append-version="true" />
    }
    else if (pageTitle == "Contact")
    {
        <link href="~/css/Admin/contact.css" rel="stylesheet" asp-append-version="true" />
    }
    else if (pageTitle == "Feedback")
    {
        <link href="~/css/Admin/feedback.css" rel="stylesheet" asp-append-version="true" />
    }
    else if (pageTitle == "AdminSetting")
    {
        <link href="~/css/Admin/setting.css" rel="stylesheet" asp-append-version="true" />
    }
}

<!-- ADMIN SUB-HEADER -->
<div class="border-bottom py-2" style="background-color: var(--card-bg);">
    <div class="container-fluid px-3 px-lg-4 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <button id="toggleAdminBtn" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center p-2 rounded-3" aria-label="Toggle Sidebar">
                <i class="bi bi-layout-sidebar-inset fs-5"></i>
            </button>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1">ADMIN</span>
                <h5 class="mb-0 fw-bold">
                    <a asp-action="Index" asp-controller="Admin" class="text-decoration-none text-body">
                        CodeSync Portal / <span class="text-gradient">@pageTitle</span>
                    </a>
                </h5>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle d-none d-sm-inline-block">
                <i class="bi bi-circle-fill me-1 small"></i> System Active
            </span>
        </div>
    </div>
</div>

<!-- MAIN LAYOUT (SIDEBAR + CONTENT) -->
<div class="container-fluid p-0">
    <div class="row g-0">
        <!-- SIDEBAR -->
        <aside id="sidebar" class="col-auto col-md-3 col-xl-2 border-end" style="background-color: var(--card-bg); min-height: calc(100vh - 120px);">
            <div class="p-3">
                <p class="text-uppercase text-muted fw-bold small mb-2 px-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Management</p>
                <nav class="nav flex-column gap-1">
                    <a class="nav-link @(pageTitle == "Index" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Index" asp-controller="Admin">
                        <i class="bi bi-grid-1x2-fill text-primary"></i> <span>Dashboard</span>
                    </a>
                    <a class="nav-link @(pageTitle == "Course" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Course" asp-controller="Admin">
                        <i class="bi bi-journal-code text-warning"></i> <span>Courses</span>
                    </a>
                    <a class="nav-link @(pageTitle == "Students" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Students" asp-controller="Admin">
                        <i class="bi bi-people-fill text-info"></i> <span>Students</span>
                    </a>
                    <a class="nav-link @(pageTitle == "Teacher" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Teacher" asp-controller="Admin">
                        <i class="bi bi-person-badge-fill text-success"></i> <span>Instructors</span>
                    </a>
                    <a class="nav-link @(pageTitle == "Product" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Product" asp-controller="Admin">
                        <i class="bi bi-box-seam-fill text-secondary"></i> <span>Products</span>
                    </a>
                </nav>

                <hr class="my-3 border-secondary opacity-25">

                <p class="text-uppercase text-muted fw-bold small mb-2 px-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Communications</p>
                <nav class="nav flex-column gap-1">
                    <a class="nav-link @(pageTitle == "Contact" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Contact" asp-controller="Admin">
                        <i class="bi bi-inbox-fill text-primary"></i> <span>Contacts</span>
                    </a>
                    <a class="nav-link @(pageTitle == "Feedback" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Feedback" asp-controller="Admin">
                        <i class="bi bi-chat-square-quote-fill text-purple"></i> <span>Feedback</span>
                    </a>
                </nav>

                <hr class="my-3 border-secondary opacity-25">

                <p class="text-uppercase text-muted fw-bold small mb-2 px-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">Settings</p>
                <nav class="nav flex-column gap-1">
                    <a class="nav-link @(pageTitle == "AdminSetting" ? "active fw-bold text-primary bg-primary-subtle" : "text-body") rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="AdminSetting" asp-controller="Admin">
                        <i class="bi bi-gear-fill text-secondary"></i> <span>Account Settings</span>
                    </a>
                    <a class="nav-link text-danger rounded-3 px-3 py-2 d-flex align-items-center gap-2" asp-action="Logout" asp-controller="Authentication">
                        <i class="bi bi-box-arrow-right text-danger"></i> <span>Sign Out</span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- CONTENT AREA -->
        <main id="content" class="col p-3 p-lg-4" style="background-color: var(--bg-color);">
            @RenderBody()
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById("sidebar");
            const toggleAdminBtn = document.getElementById("toggleAdminBtn");

            if (toggleAdminBtn && sidebar) {
                toggleAdminBtn.addEventListener("click", () => {
                    sidebar.classList.toggle("d-none");
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
}
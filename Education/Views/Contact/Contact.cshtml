@model Education.Models.ContactClass
@{
    ViewData["Title"] = "Contact Us | CodeSync Support & Admissions";
}

@section SEO {
    <meta name="description" content="Reach out to the CodeSync team for admissions advice, course inquiries, technical help, or enterprise partnerships. We're here to help you advance." />
    <meta name="keywords" content="Contact CodeSync, CodeSync Support, Programming Help, Developer Admissions" />
    <link rel="canonical" href="@SiteData.SiteUrl/Contact/Contact" />
}

<div class="container-xl py-5">
    <div class="text-center max-w-700 mx-auto mb-5">
        <div class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
            GET IN TOUCH
        </div>
        <h1 class="display-5 fw-bold">Let's Connect & Build</h1>
        <p class="text-muted">Have inquiries regarding batch schedules, syllabus specifics, or enterprise mentorship? Our team responds within 24 hours.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Contact Form -->
        <div class="col-12 col-lg-7">
            <div class="card p-4 p-md-5 border-0 shadow-sm">
                <h4 class="fw-bold mb-4">Send a Message</h4>

                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@ViewBag.Success</span>
                    </div>
                }

                @if (ViewBag.Msg != null)
                {
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>@ViewBag.Msg</span>
                    </div>
                }

                <form method="post" asp-antiforgery="true">
                    <div class="mb-3">
                        <label asp-for="ContactEmail" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="ContactEmail" class="form-control form-control-lg" placeholder="your.name@example.com" />
                        <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ContactMessage" class="form-label fw-semibold">Message</label>
                        <textarea asp-for="ContactMessage" class="form-control form-control-lg" rows="5" placeholder="How can we assist your software development journey?"></textarea>
                        <span asp-validation-for="ContactMessage" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-send-fill me-2"></i> Send Message
                    </button>
                </form>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="col-12 col-lg-5">
            <div class="d-flex flex-column gap-3">
                <div class="card p-4 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                            <i class="bi bi-geo-alt-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Academy Location</h6>
                            <small class="text-muted">HQ & Regional Center</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-0 ps-5">Brahmasthan, Azamgarh (UP), India</p>
                </div>

                <div class="card p-4 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="p-3 rounded-circle bg-success-subtle text-success">
                            <i class="bi bi-telephone-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Direct Helpline</h6>
                            <small class="text-muted">Mon - Sat, 9 AM - 7 PM IST</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-0 ps-5">+91 97087 98088</p>
                </div>

                <div class="card p-4 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="p-3 rounded-circle bg-info-subtle text-info">
                            <i class="bi bi-envelope-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Admissions & Support</h6>
                            <small class="text-muted">Online Inquiries</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-0 ps-5">contact@codesync.com</p>
                </div>

                <div class="card p-4 border-0 shadow-sm bg-gradient-brand text-white">
                    <h5 class="fw-bold mb-2">Join Developer Office Hours</h5>
                    <p class="text-white-50 small mb-0">Connect directly with mentors during open Friday community technical sessions on Discord.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

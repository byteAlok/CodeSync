@model Education.Models.UserClass
@{
    Layout = "_UserSidebarlayout";
    ViewData["Title"] = "Account";
}

<div class="container-fluid py-2">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Student Profile & Settings</h2>
            <p class="text-muted small mb-0">Manage your CodeSync learner profile, credentials, and contact preferences.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#exampleModal">
                <i class="bi bi-pencil-square me-1"></i> Edit Profile
            </button>
        </div>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Msg"]</span>
        </div>
    }

    <div class="row g-4">
        <!-- Avatar & Summary Card -->
        <div class="col-12 col-lg-4">
            <div class="card p-4 border-0 shadow-sm text-center">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    <img src="@Model.UserImage" class="rounded-circle shadow-sm border border-3 border-primary" style="width: 120px; height: 120px; object-fit: cover;" alt="@Model.UserFullName" onerror="this.src='/images/home-images/Alok_Maurya.jpg'" />
                </div>
                <h4 class="fw-bold mb-1">@Model.UserFullName</h4>
                <p class="text-primary small fw-semibold mb-2"><i class="bi bi-at"></i>@Model.UserName</p>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-3">Verified Student</span>

                <hr class="my-3 border-secondary-subtle">

                <div class="text-start small text-muted d-flex flex-column gap-2">
                    <div><i class="bi bi-envelope-fill me-2 text-primary"></i>@Model.UserEmail</div>
                    <div><i class="bi bi-geo-alt-fill me-2 text-danger"></i>India</div>
                    <div><i class="bi bi-calendar-event me-2 text-info"></i>Joined: @Model.UserRegisterDate</div>
                </div>
            </div>
        </div>

        <!-- Details Table Card -->
        <div class="col-12 col-lg-8">
            <div class="card p-4 border-0 shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h5 class="fw-bold mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i>Personal Details</h5>
                    <button type="button" class="btn btn-outline-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        Update Information
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 30%;">Full Name</th>
                                <td class="fw-semibold">@Model.UserFullName</td>
                            </tr>
                            <tr>
                                <th>Username</th>
                                <td>@Model.UserName</td>
                            </tr>
                            <tr>
                                <th>Email Address</th>
                                <td>@Model.UserEmail</td>
                            </tr>
                            <tr>
                                <th>Date of Birth</th>
                                <td>@Model.UserDOB</td>
                            </tr>
                            <tr>
                                <th>Registration Date</th>
                                <td>@Model.UserRegisterDate</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="exampleModalLabel"><i class="bi bi-person-gear text-primary me-2"></i>Update Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="UpdateUser" asp-controller="User" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="a1">Full Name</label>
                        <input type="text" class="form-control" id="a1" name="UserFullName" value="@ViewBag.uFullName" placeholder="Update full name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="a2">Username</label>
                        <input type="text" class="form-control" id="a2" name="UserName" value="@ViewBag.uName" placeholder="Update username" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="a3">Email Address</label>
                        <input type="email" class="form-control" id="a3" name="UserEmail" value="@ViewBag.uEmail" placeholder="Update email" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="a4">Date of Birth</label>
                        <input type="date" class="form-control" id="a4" name="UserDOB" value="@ViewBag.uDob" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold small" for="a5">Profile Picture (Optional)</label>
                        <input type="file" accept="image/*" class="form-control" id="a5" name="file" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="register">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
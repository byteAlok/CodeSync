@model Education.Models.CourseClass
@{
    Layout = "_UserSidebarlayout";
    ViewData["Title"] = "Study Workspace";
}

<div class="container-fluid py-2">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <a asp-action="Courses" asp-controller="User" class="btn btn-outline-secondary btn-sm px-3 mb-2" id="login">
                <i class="bi bi-arrow-left me-1"></i> Back to My Courses
            </a>
            <h2 class="fw-bold mb-1">Learning Space: <span class="text-gradient">@Model.CourseName</span></h2>
            <p class="text-muted small mb-0">Module content, video lectures, and code laboratories for this active track.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card p-4 border-0 shadow-sm mb-4">
                <div class="ratio ratio-16x9 rounded-3 overflow-hidden mb-4 bg-dark">
                    <img src="~/images/course-images/@Model.CourseImage" alt="@Model.CourseName" class="object-fit-cover w-100 h-100 opacity-75" onerror="this.src='/images/course-images/Full_Stack_Web_Development__202512012038141148.png'" />
                </div>
                <h4 class="fw-bold mb-2">Welcome to your Course Lab</h4>
                <p class="text-muted">
                    You have full access to all curriculum modules for <strong>@Model.CourseName</strong>. Follow along with your mentor's instruction, write clean testable code, and submit milestone assessments for feedback.
                </p>
                <div class="d-flex gap-3 mt-3">
                    <a asp-action="Courses" asp-controller="User" class="btn btn-primary px-4">
                        <i class="bi bi-journal-check me-1"></i> View All Track Modules
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card p-4 border-0 shadow-sm mb-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-bookmark-check text-primary me-2"></i>Curriculum Details</h6>
                <ul class="list-unstyled d-flex flex-column gap-2 small text-muted mb-0">
                    <li><strong class="text-body">Language:</strong> @Model.CourseLanguage</li>
                    <li><strong class="text-body">Batch Started:</strong> @Model.CourseStartDate</li>
                    <li><strong class="text-body">Access Valid:</strong> @Model.CourseEndDate</li>
                    <li><strong class="text-body">Track Duration:</strong> @Model.CourseDuration Months</li>
                </ul>
            </div>
        </div>
    </div>
</div>
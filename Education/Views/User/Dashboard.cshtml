@{
    Layout = "_UserSidebarlayout";
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-2">
    <!-- Welcome Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4 p-4 rounded-4 bg-gradient-brand text-white shadow-sm">
        <div>
            <span class="badge bg-white text-dark fw-bold px-3 py-1 rounded-pill mb-2">STUDENT WORKSPACE</span>
            <h2 class="fw-bold mb-1">Welcome, @ViewBag.UserFullName!</h2>
            <p class="text-white-50 mb-0">Continue building your skills and tracking your active curriculum modules.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Courses" asp-controller="User" class="btn btn-light text-dark fw-bold px-3 py-2 text-nowrap">
                <i class="bi bi-play-circle-fill me-1 text-primary"></i> Resume Learning
            </a>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="row g-3 mb-4">
        <!-- 1. Enrolled Courses -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 p-3 border-0 shadow-sm hover-lift">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-primary-subtle text-primary">
                        <i class="bi bi-mortarboard-fill fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <span class="text-muted small fw-semibold d-block">Enrolled Courses</span>
                        <h3 class="fw-bold mb-0">@ViewBag.UserCourseCount</h3>
                    </div>
                </div>
                <hr class="my-3 border-secondary-subtle">
                <a asp-action="Courses" asp-controller="User" class="text-primary fw-semibold text-decoration-none small d-flex align-items-center justify-content-between">
                    <span>View Enrolled</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- 2. Available Courses -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 p-3 border-0 shadow-sm hover-lift">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-success-subtle text-success">
                        <i class="bi bi-bag-check-fill fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <span class="text-muted small fw-semibold d-block">Available Batches</span>
                        <h3 class="fw-bold mb-0">@ViewBag.CourseCount</h3>
                    </div>
                </div>
                <hr class="my-3 border-secondary-subtle">
                <a asp-action="AvailableCourses" asp-controller="User" class="text-success fw-semibold text-decoration-none small d-flex align-items-center justify-content-between">
                    <span>Explore Catalog</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- 3. Contact Messages -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 p-3 border-0 shadow-sm hover-lift">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-info-subtle text-info">
                        <i class="bi bi-envelope-fill fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <span class="text-muted small fw-semibold d-block">Sent Messages</span>
                        <h3 class="fw-bold mb-0">@ViewBag.ContactCount</h3>
                    </div>
                </div>
                <hr class="my-3 border-secondary-subtle">
                <a asp-action="Contacts" asp-controller="User" class="text-info fw-semibold text-decoration-none small d-flex align-items-center justify-content-between">
                    <span>View Inbox</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- 4. Feedback Submissions -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100 p-3 border-0 shadow-sm hover-lift">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-3 bg-warning-subtle text-warning">
                        <i class="bi bi-chat-dots-fill fs-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <span class="text-muted small fw-semibold d-block">Feedback Given</span>
                        <h3 class="fw-bold mb-0">@ViewBag.FeedbackCount</h3>
                    </div>
                </div>
                <hr class="my-3 border-secondary-subtle">
                <a asp-action="Feedback" asp-controller="User" class="text-warning fw-semibold text-decoration-none small d-flex align-items-center justify-content-between">
                    <span>Feedback Log</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Student Profile & Actions Row -->
    <div class="row g-3">
        <!-- Student Profile Card -->
        <div class="col-12 col-lg-8">
            <div class="card p-4 border-0 shadow-sm h-100">
                <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
                    <img src="/Authentication/GetImage?file=@ViewBag.UserImage" class="rounded-circle shadow-sm border border-3 border-primary" style="width: 100px; height: 100px; object-fit: cover;" alt="@ViewBag.UserFullName" onerror="this.src='/images/home-images/Alok_Maurya.jpg'" />
                    <div class="text-center text-sm-start flex-grow-1">
                        <div class="d-flex flex-column flex-sm-row align-items-center gap-2 mb-1">
                            <h4 class="fw-bold mb-0">@ViewBag.UserFullName</h4>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Active Learner</span>
                        </div>
                        <p class="text-muted small mb-2"><i class="bi bi-at"></i>@ViewBag.UserName</p>
                        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-sm-start">
                            <a asp-action="Account" asp-controller="User" class="btn btn-outline-primary btn-sm px-3">
                                <i class="bi bi-gear-fill me-1"></i> Edit Profile
                            </a>
                            <a asp-action="AvailableCourses" asp-controller="User" class="btn btn-primary btn-sm px-3">
                                <i class="bi bi-plus-lg me-1"></i> Enroll in New Course
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Links Hub -->
        <div class="col-12 col-lg-4">
            <div class="card p-4 border-0 shadow-sm h-100 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge text-warning me-2"></i>Quick Actions</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a asp-action="Courses" asp-controller="User" class="text-decoration-none text-body d-flex align-items-center justify-content-between p-2 rounded bg-body-tertiary"><span><i class="bi bi-journal-code text-primary me-2"></i>Access Course Materials</span> <i class="bi bi-chevron-right text-muted"></i></a></li>
                        <li><a asp-action="Contacts" asp-controller="User" class="text-decoration-none text-body d-flex align-items-center justify-content-between p-2 rounded bg-body-tertiary"><span><i class="bi bi-chat-left-text text-info me-2"></i>Message Mentor Desk</span> <i class="bi bi-chevron-right text-muted"></i></a></li>
                    </ul>
                </div>
                <div class="pt-3 border-top border-secondary-subtle">
                    <a asp-action="Logout" asp-controller="Authentication" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@model IEnumerable<Education.Models.UserClass>
@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Students";
}

<div class="container-fluid py-2">
    <!-- Alerts Area -->
    @if (TempData["UpdateSuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["UpdateSuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["StudentDeleteSuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["StudentDeleteSuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Student Management & Analytics</h2>
            <p class="text-muted small mb-0">Monitor student registrations, view learner profiles, and update account details.</p>
        </div>
    </div>

    <!-- Stat Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <a asp-action="Index" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-primary-subtle text-primary">
                            <i class="bi bi-shield-lock-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">System Admins</span>
                            <h3 class="fw-bold mb-0 text-body">@ViewBag.AdminCount</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Students" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-success-subtle text-success">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Total Students</span>
                            <h3 class="fw-bold mb-0 text-body">@(ViewBag.TotalStudents ?? ViewBag.Totalstudents)</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Course" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-warning-subtle text-warning">
                            <i class="bi bi-journal-code fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Active Tracks</span>
                            <h3 class="fw-bold mb-0 text-body">@ViewBag.TotalCourse</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Student Analytics Dashboard -->
    <div class="card p-4 border-0 shadow-sm mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Student Registration Analytics</h5>
        
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="p-3 rounded-3 bg-body-tertiary text-center">
                    <small class="text-muted d-block">Total Registered</small>
                    <h3 id="totalStudents" class="fw-bold text-primary mb-0">@ViewBag.TotalStudents</h3>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="p-3 rounded-3 bg-body-tertiary text-center">
                    <small class="text-muted d-block">Active Students</small>
                    <h3 id="activeStudents" class="fw-bold text-success mb-0">@ViewBag.ActiveStudents</h3>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="p-3 rounded-3 bg-body-tertiary text-center">
                    <small class="text-muted d-block">Inactive Students</small>
                    <h3 id="inactiveStudents" class="fw-bold text-danger mb-0">@ViewBag.InactiveStudents</h3>
                </div>
            </div>
        </div>

        <div style="position: relative; height: 220px;">
            <canvas id="studentChart"></canvas>
        </div>
    </div>

    <hr class="my-4 border-secondary-subtle">

    <!-- Students Directory Grid -->
    <div class="mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-person-lines-fill text-primary me-2"></i>Learner Accounts</h5>
        <div class="row g-4">
            @if (Model != null)
            {
                foreach (var userstudents in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 p-3 border-0 shadow-sm text-center hover-lift d-flex flex-column">
                            <div class="mb-3 mx-auto">
                                @if (!string.IsNullOrEmpty(userstudents.UserImage))
                                {
                                    <img src="@Url.Action("ShowAdminImage", "Admin", new { FileName = userstudents.UserImage })" class="rounded-circle shadow-sm border border-2 border-primary" style="width: 80px; height: 80px; object-fit: cover;" alt="@userstudents.UserName" onerror="this.src='/images/home-images/Alok_Maurya.jpg'" />
                                }
                                else
                                {
                                    <img src="/images/home-images/Alok_Maurya.jpg" class="rounded-circle shadow-sm border border-2 border-primary" style="width: 80px; height: 80px; object-fit: cover;" alt="Default" />
                                }
                            </div>

                            <h6 class="fw-bold mb-1 text-truncate" title="@userstudents.UserFullName">@userstudents.UserFullName</h6>
                            <p class="text-primary small fw-semibold mb-2"><i class="bi bi-at"></i>@userstudents.UserName</p>
                            <span class="badge bg-body-secondary text-body mb-2 mx-auto">ID #@userstudents.UserId</span>

                            <div class="small text-muted mb-3 flex-grow-1 text-start">
                                <div class="text-truncate" title="@userstudents.UserEmail"><i class="bi bi-envelope me-1"></i>@userstudents.UserEmail</div>
                                <div><i class="bi bi-calendar me-1"></i>DOB: @userstudents.UserDOB</div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm flex-fill" data-bs-toggle="modal" data-bs-target="#updateModal_@userstudents.UserId">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm flex-fill" data-bs-toggle="modal" data-bs-target="#deleteModal_@userstudents.UserId">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Update Student Modal -->
                    <div class="modal fade" id="updateModal_@userstudents.UserId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Update Student Profile</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="Updatestudent" asp-controller="Admin" method="post" enctype="multipart/form-data">
                                    <div class="modal-body p-4">
                                        <input type="hidden" name="UserId" value="@userstudents.UserId" />

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Username</label>
                                            <input type="text" class="form-control" name="UserName" value="@userstudents.UserName" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Full Name</label>
                                            <input type="text" class="form-control" name="UserFullName" value="@userstudents.UserFullName" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Email Address</label>
                                            <input type="email" class="form-control" name="UserEmail" value="@userstudents.UserEmail" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Date of Birth</label>
                                            <input type="date" class="form-control" name="UserDOB" value="@userstudents.UserDOB" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label fw-semibold small">New Profile Image (Optional)</label>
                                            <input type="file" class="form-control" name="UserImage" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Delete Student Modal -->
                    <div class="modal fade" id="deleteModal_@userstudents.UserId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header border-danger-subtle">
                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Student Deletion</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="DeleteStudent" asp-controller="Admin" method="post">
                                    <div class="modal-body p-4 text-center">
                                        <input type="hidden" name="StudentId" value="@userstudents.UserId" />
                                        <p class="mb-1">Are you sure you want to delete student <strong>@userstudents.UserName</strong>?</p>
                                        <small class="text-danger">This will remove their profile and all course enrollments.</small>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Delete Student</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const ctx = document.getElementById('studentChart');
            if (ctx) {
                const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                new Chart(ctx.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: months,
                        datasets: [{
                            label: 'Monthly New Registrations',
                            data: [12, 19, 25, 32, 45, 58, 65, 72, 80, 88, 95, 110],
                            borderColor: 'rgba(59, 130, 246, 1)',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            fill: true,
                            tension: 0.35,
                            pointRadius: 4,
                            pointBackgroundColor: '#FFFFFF',
                            pointBorderColor: 'rgba(59, 130, 246, 1)'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, grid: { color: 'rgba(128, 128, 128, 0.1)' } },
                            x: { grid: { display: false } }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }
        });
    </script>
}
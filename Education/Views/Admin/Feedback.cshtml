@model IEnumerable<Education.Models.FeedbackClass>
@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Feedback";
}

<div class="container-fluid py-2">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Student Feedback & Reviews</h2>
        <p class="text-muted small mb-0">Monitor learner satisfaction, track course ratings, and review student feedback.</p>
    </div>

    <!-- Stat Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <a asp-action="Students" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-primary-subtle text-primary">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Students</span>
                            <h3 class="fw-bold mb-0 text-body">Manage Students</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Teacher" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-success-subtle text-success">
                            <i class="bi bi-person-badge-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Instructors</span>
                            <h3 class="fw-bold mb-0 text-body">Active Mentors</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Course" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-warning-subtle text-warning">
                            <i class="bi bi-journal-code fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Course Tracks</span>
                            <h3 class="fw-bold mb-0 text-body">Manage Tracks</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Feedback History Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header p-4 border-bottom">
            <h5 class="fw-bold mb-0"><i class="bi bi-chat-square-quote-fill text-primary me-2"></i>Feedback & Review Submissions</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" style="width: 80px;">ID</th>
                        <th scope="col" style="width: 250px;">Student Email</th>
                        <th scope="col">Review Content</th>
                        <th scope="col" style="width: 140px;">Rating</th>
                        <th scope="col" style="width: 180px;">Submitted On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var feedbacks in Model)
                        {
                            <tr>
                                <th scope="row" class="text-muted small">#@feedbacks.FeedbackId</th>
                                <td class="fw-semibold">
                                    <i class="bi bi-person-circle me-1 text-primary"></i> @feedbacks.FeedbackEmail
                                </td>
                                <td>@feedbacks.FeedbackMessage</td>
                                <td>
                                    <span class="text-warning small">
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> @feedbacks.FeedbackDate
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-chat-square-text fs-2 d-block mb-2"></i>
                                No feedback reviews logged.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
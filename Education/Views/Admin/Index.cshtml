@model IEnumerable<Education.Models.Admin>
@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Index";
}

<div class="container-fluid py-2">
    <!-- Alerts Area -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminCreateSuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["AdminCreateSuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["AdminCreateErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["AdminCreateErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action Row -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Administrator Dashboard</h2>
            <p class="text-muted small mb-0">System administration, team permissions, and platform metrics overview.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                <i class="bi bi-person-plus-fill me-1"></i> Create New Administrator
            </button>
        </div>
    </div>

    <!-- Stat Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <a asp-action="Index" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-primary-subtle text-primary">
                            <i class="bi bi-shield-lock-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">System Admins</span>
                            <h3 class="fw-bold mb-0 text-body">@ViewBag.TotalAdmin</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Students" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-success-subtle text-success">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Registered Students</span>
                            <h3 class="fw-bold mb-0 text-body">@ViewBag.TotalStudent</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Course" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-warning-subtle text-warning">
                            <i class="bi bi-journal-code fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Active Courses</span>
                            <h3 class="fw-bold mb-0 text-body">@ViewBag.TotalCourse</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <hr class="my-4 border-secondary-subtle">

    <!-- Admin Team Grid -->
    <div class="mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-shield-shaded text-primary me-2"></i>Admin Accounts</h5>
        <div class="row g-4">
            @if (Model != null)
            {
                foreach (var items in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 p-3 border-0 shadow-sm text-center hover-lift d-flex flex-column">
                            <div class="mb-3 mx-auto">
                                <img src="/Admin/AdminSettingImageShow?FileName=@items.AdminImage" class="rounded-circle shadow-sm border border-2 border-primary" style="width: 90px; height: 90px; object-fit: cover;" alt="@items.AdminName" onerror="this.src='/images/home-images/Alok_Maurya.jpg'" />
                            </div>
                            <h5 class="fw-bold mb-1">@items.AdminName</h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2 mx-auto">Admin #@items.AdminId</span>
                            
                            <div class="small text-muted mb-3 flex-grow-1 text-start">
                                <div><i class="bi bi-envelope me-1"></i>@items.AdminEmail</div>
                                <div><i class="bi bi-telephone me-1"></i>@items.AdminPhone</div>
                                <div><i class="bi bi-calendar me-1"></i>DOB: @items.AdminDOB</div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm flex-fill" data-bs-toggle="modal" data-bs-target="#updateModal_@items.AdminId">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm flex-fill" data-bs-toggle="modal" data-bs-target="#deleteModal_@items.AdminId">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Update Modal -->
                    <div class="modal fade" id="updateModal_@items.AdminId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Update Administrator</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="Edit" asp-controller="Admin" method="post" enctype="multipart/form-data">
                                    <div class="modal-body p-4">
                                        <input type="hidden" name="AdminId" value="@items.AdminId" />

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Full Name</label>
                                            <input type="text" class="form-control" name="AdminName" value="@items.AdminName" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Email Address</label>
                                            <input type="email" class="form-control" name="AdminEmail" value="@items.AdminEmail" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Date of Birth</label>
                                            <input type="date" class="form-control" name="AdminDOB" value="@items.AdminDOB" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Phone Number</label>
                                            <input type="text" class="form-control" name="AdminPhone" value="@items.AdminPhone" required />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label fw-semibold small">Profile Picture (Optional)</label>
                                            <input type="file" class="form-control" name="AdminImage" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Delete Modal -->
                    <div class="modal fade" id="deleteModal_@items.AdminId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header border-danger-subtle">
                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="DeleteConfirmed" asp-controller="Admin" method="post">
                                    <div class="modal-body p-4 text-center">
                                        <input type="hidden" name="AdminId" value="@items.AdminId" />
                                        <p class="mb-1">Are you sure you want to delete administrator <strong>@items.AdminName</strong>?</p>
                                        <small class="text-danger">This administrative action is permanent and cannot be undone.</small>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Create Admin Modal -->
<div class="modal fade" id="createAdminModal" tabindex="-1" aria-labelledby="createAdminLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="createAdminLabel"><i class="bi bi-person-plus-fill text-primary me-2"></i>Create New Administrator</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form enctype="multipart/form-data" asp-action="CreateAdmin" asp-controller="Admin" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Admin Full Name</label>
                            <input type="text" name="AdminName" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Date of Birth</label>
                            <input type="date" name="AdminDOB" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Email Address</label>
                            <input type="email" name="AdminEmail" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Phone Number</label>
                            <input type="text" name="AdminPhone" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Password</label>
                            <input type="password" name="AdminPassword" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold small">Confirm Password</label>
                            <input type="password" name="ConfirmPassword" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Profile Picture</label>
                            <input type="file" name="AdminImage" class="form-control" accept="image/*" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Admin Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

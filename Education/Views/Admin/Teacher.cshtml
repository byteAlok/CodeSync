@{
    Layout = "_AdminSidebar";
    ViewData["Title"] = "Teacher";
}

<div class="container-fluid py-2">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Instructor & Mentor Management</h2>
        <p class="text-muted small mb-0">Oversee course mentors, assign teaching tracks, and schedule live code reviews.</p>
    </div>

    <!-- Stat Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <a asp-action="Students" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-primary-subtle text-primary">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Students</span>
                            <h3 class="fw-bold mb-0 text-body">Manage Students</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Teacher" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-success-subtle text-success">
                            <i class="bi bi-person-badge-fill fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Instructors</span>
                            <h3 class="fw-bold mb-0 text-body">Active Mentors</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-12 col-md-4">
            <a asp-action="Course" asp-controller="Admin" class="text-decoration-none">
                <div class="card p-3 border-0 shadow-sm hover-lift">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3 bg-warning-subtle text-warning">
                            <i class="bi bi-journal-code fs-3"></i>
                        </div>
                        <div>
                            <span class="text-muted small fw-semibold d-block">Course Tracks</span>
                            <h3 class="fw-bold mb-0 text-body">Manage Tracks</h3>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Feature Preview Card -->
    <div class="card p-5 border-0 shadow-sm text-center">
        <div class="p-3 rounded-circle bg-primary-subtle text-primary d-inline-flex mx-auto mb-3" style="width: 64px; height: 64px; align-items: center; justify-content: center;">
            <i class="bi bi-tools fs-3"></i>
        </div>
        <h3 class="fw-bold mb-2">Instructor Scheduling Module</h3>
        <p class="text-muted max-w-700 mx-auto mb-4">
            The dedicated Instructor Portal with automated calendar syncing, office hours bookings, and batch payroll is currently under active engineering.
        </p>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill mx-auto">
            <i class="bi bi-clock-history me-1"></i> Coming in Next Sprint
        </span>
    </div>
</div>